---
// A screenshot of the app in the page's language, in the light or dark version that matches the docs theme.
// Files live in src/assets/screenshots as <name>-<en|es>-<light|dark>.webp.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  alt: string;
}
const { name, alt } = Astro.props;
const lang = Astro.currentLocale === 'es' ? 'es' : 'en';
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/*.webp', { eager: true });
const pick = (theme: 'light' | 'dark') => {
  const shot = shots[`../assets/screenshots/${name}-${lang}-${theme}.webp`];
  if (!shot) throw new Error(`Missing screenshot ${name}-${lang}-${theme}.webp`);
  return shot.default;
};
---

<Image src={pick('light')} alt={alt} class="shot dark:sl-hidden" widths={[800, 1600]} sizes="(min-width: 72rem) 45rem, 100vw" />
<Image src={pick('dark')} alt={alt} class="shot light:sl-hidden" widths={[800, 1600]} sizes="(min-width: 72rem) 45rem, 100vw" />
