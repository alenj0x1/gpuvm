---
// One card of a diagram: a title and a list of items, each with its Bauhaus shape.
import Shape from './Shape.astro';

export type DiagramItem = { shape: 'circle' | 'square' | 'triangle' | 'quarter'; color: 'red' | 'yellow' | 'green' | 'blue'; label: string };
interface Props {
  title: string;
  items: DiagramItem[];
}
const { title, items } = Astro.props;
---
<div class="gv-card">
  <p class="gv-card-title">{title}</p>
  <ul>{items.map((item) => <li><Shape kind={item.shape} color={item.color} />{item.label}</li>)}</ul>
</div>
