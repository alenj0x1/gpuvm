{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "panels",
  "description": "The viewer's side panel: only what it shows and does",
  "windows": ["viewer-panel"],
  "permissions": [
    "core:default", "core:window:allow-start-dragging", "core:window:allow-close",
    "allow-ps",
    "allow-viewer-send", "allow-viewer-panel-resize", "allow-viewer-panel-close", "allow-viewer-panel-vm",
    "allow-transfer-start", "allow-transfer-cancel", "allow-transfer-list",
    "allow-clipboard-items", "allow-clipboard-send", "allow-clipboard-auto", "allow-clipboard-clear",
    "allow-capture-open", "allow-capture-reveal", "allow-capture-open-folder", "allow-capture-state", "allow-status-state", "allow-status-action"
  ]
}
