{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GpuVM",
  "version": "0.5.0",
  "identifier": "dev.alejandro.gpuvm",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "node scripts/prepare.mjs && npm run dev",
    "beforeBuildCommand": "npm run build && node scripts/prepare.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "GpuVM",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#f6f5f2",
        "decorations": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../../src/": "gpuvm/src/",
      "../../profiles/": "gpuvm/profiles/",
      "../../guest/": "gpuvm/guest/",
      "../../templates/": "gpuvm/templates/",
      "../../streaming/": "gpuvm/streaming/",
      "../../apps/": "gpuvm/apps/",
      "../.cache/pwsh/": "pwsh/",
      "../host/target/release/gpuvm-host.exe": "gpuvm-host.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "Spanish"
        ],
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
